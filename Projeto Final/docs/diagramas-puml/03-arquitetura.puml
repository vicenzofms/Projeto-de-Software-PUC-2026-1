@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()
title Arquitetura em Camadas (Layered) - ReparoTech

Person(funcionario, "Funcionario", "Operacao diaria: cadastros, diagnostico, orcamento, execucao, pagamento")
Person(gerente, "Gerente", "Administracao: catalogo, funcionarios, relatorios")
Person_Ext(cliente, "Cliente", "Recebe notificacoes por e-mail")

System_Boundary(reparotech, "ReparoTech") {
  Container(apresentacao, "Camada de Apresentacao", "Angular 21", "Web App SPA no navegador do Funcionario e do Gerente")
  Container(aplicacao, "Camada de Aplicacao", "Next.js", "Controllers REST + Application Services (orquestram os casos de uso)")
  Container(dominio, "Camada de Dominio", "TypeScript", "Entidades, Regras de Negocio, Enums e Value Objects")
  Container(infraestrutura, "Camada de Infraestrutura", "Prisma + JWT", "Repositories, Auth Middleware (JWT) e Clients HTTP/SMTP")
  ContainerDb(db, "PostgreSQL", "PostgreSQL 16", "Persistencia relacional")
}

System_Ext(pagamento, "Sistema de Pagamento", "Processa cartao e Pix")
System_Ext(smtp, "Servico SMTP", "Envio de e-mails ao cliente")

Rel(funcionario, apresentacao, "Usa", "HTTPS")
Rel(gerente, apresentacao, "Usa", "HTTPS")
Rel_D(apresentacao, aplicacao, "depende de", "REST/JSON + JWT")
Rel_D(aplicacao, dominio, "depende de")
Rel_D(dominio, infraestrutura, "depende de")
Rel_D(infraestrutura, db, "le e persiste", "SQL via Prisma")
Rel(infraestrutura, pagamento, "processa pagamentos", "HTTPS REST")
Rel(infraestrutura, smtp, "envia notificacoes", "SMTP assincrono")
Rel(smtp, cliente, "notifica", "e-mail")
@enduml
