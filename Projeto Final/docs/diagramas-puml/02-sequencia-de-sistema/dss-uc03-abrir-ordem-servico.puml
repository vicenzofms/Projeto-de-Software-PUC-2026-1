@startuml dss-uc03-abrir-ordem-servico
actor Funcionario
participant ":Sistema" as Sistema

Funcionario -> Sistema: autenticar(login, senha)
activate Sistema
Sistema --> Funcionario: sessaoJWT
deactivate Sistema

Funcionario -> Sistema: buscarCliente(cpf)
activate Sistema
Sistema --> Funcionario: clienteDTO ou NaoEncontrado
deactivate Sistema

opt Cliente nao cadastrado
    Funcionario -> Sistema: cadastrarCliente(nome, cpf, telefone, email, endereco)
    activate Sistema
    note right of Sistema: Valida CPF e unicidade
    Sistema --> Funcionario: clienteDTO
    deactivate Sistema
end

Funcionario -> Sistema: listarEquipamentos(clienteId)
activate Sistema
Sistema --> Funcionario: listaEquipamentos
deactivate Sistema

opt Equipamento nao cadastrado
    Funcionario -> Sistema: cadastrarEquipamento(clienteId, tipo, marca, modelo, numeroSerie)
    activate Sistema
    Sistema --> Funcionario: equipamentoDTO
    deactivate Sistema
end

Funcionario -> Sistema: abrirOrdemServico(clienteId, equipamentoId, problemaRelatado)
activate Sistema
note right of Sistema: Toda Ordem de Servico inicia com status Aberta\ne registra entrada no historico
Sistema --> Funcionario: ordemServicoDTO (status=Aberta)
deactivate Sistema
@enduml
