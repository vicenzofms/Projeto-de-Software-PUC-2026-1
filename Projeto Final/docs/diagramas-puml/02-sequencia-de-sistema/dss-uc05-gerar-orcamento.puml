@startuml dss-uc05-gerar-orcamento
actor Funcionario
participant ":Sistema" as Sistema

Funcionario -> Sistema: selecionarOrdemServico(ordemServicoId)
activate Sistema
note right of Sistema: Ordem de Servico deve ter diagnostico\nregistrado (UC-04)
Sistema --> Funcionario: ordemServicoDTO com diagnostico
deactivate Sistema

Funcionario -> Sistema: listarCatalogoServicos()
activate Sistema
Sistema --> Funcionario: listaServicos
deactivate Sistema

Funcionario -> Sistema: listarCatalogoPecas()
activate Sistema
Sistema --> Funcionario: listaPecas com saldoEstoque
deactivate Sistema

loop Para cada item do orcamento
    alt Item do tipo Servico
        Funcionario -> Sistema: adicionarItemOrcamento(ordemServicoId, "servico", servicoId, quantidade)
        activate Sistema
        Sistema --> Funcionario: itemAdicionado
        deactivate Sistema
    else Item do tipo Peca
        Funcionario -> Sistema: adicionarItemOrcamento(ordemServicoId, "peca", pecaId, quantidade)
        activate Sistema
        opt Peca indisponivel em estoque
            note right of Sistema: Bloqueia uso sem estoque\n(regra de negocio)
            Sistema --> Funcionario: erro(pecaIndisponivel)
            Funcionario -> Sistema: marcarPecaSolicitada(ordemServicoId, pecaId, quantidade)
            Sistema --> Funcionario: pecaMarcadaParaCompra
        end
        Sistema --> Funcionario: itemAdicionado
        deactivate Sistema
    end
end

Funcionario -> Sistema: confirmarOrcamento(ordemServicoId)
activate Sistema
note right of Sistema: Calcula valor total e\nmuda status para\nAguardando Aprovacao
Sistema --> Funcionario: orcamentoDTO (valorTotal, status=AguardandoAprovacao)
deactivate Sistema
@enduml
