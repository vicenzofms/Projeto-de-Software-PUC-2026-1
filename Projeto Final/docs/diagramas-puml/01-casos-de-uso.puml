@startuml
left to right direction

actor Cliente
actor Funcionario
actor Gerente
actor "Sistema de Pagamento" as SP

Gerente --|> Funcionario

rectangle "ReparoTech" {
  package "Atendimento" {
    usecase "UC-01\nCadastrar Cliente" as UC01
    usecase "UC-02\nCadastrar Equipamento" as UC02
    usecase "UC-03\nAbrir Ordem de Servico" as UC03
    usecase "UC-04\nRegistrar Diagnostico" as UC04
    usecase "UC-05\nGerar Orcamento" as UC05
    usecase "UC-06\nAprovar ou Recusar Orcamento" as UC06
    usecase "UC-07\nExecutar Servico" as UC07
    usecase "UC-08\nRegistrar Uso de Pecas" as UC08
    usecase "UC-09\nRegistrar Pagamento" as UC09
    usecase "UC-10\nFinalizar Ordem de Servico" as UC10
    usecase "UC-11\nRegistrar Retirada do Equipamento" as UC11
  }

  package "Administracao" {
    usecase "UC-12\nGerenciar Pecas e Estoque" as UC12
    usecase "UC-13\nGerenciar Servicos e Precos" as UC13
    usecase "UC-14\nGerenciar Funcionarios" as UC14
    usecase "UC-15\nGerar Relatorios Gerenciais" as UC15
  }

  usecase "Autenticar Usuario" as UCAuth
  usecase "Verificar Estoque" as UCEstoque
  usecase "Confirmar Pagamento" as UCConfPag
  usecase "Cancelar Ordem de Servico" as UCCancel
}

Funcionario --> UC01
Funcionario --> UC02
Funcionario --> UC03
Funcionario --> UC04
Funcionario --> UC05
Funcionario --> UC07
Funcionario --> UC09
Funcionario --> UC10
Funcionario --> UC11

Cliente --> UC06

Gerente --> UC12
Gerente --> UC13
Gerente --> UC14
Gerente --> UC15

UC09 --> SP

UC03 ..> UCAuth : <<include>>
UC04 ..> UCAuth : <<include>>
UC05 ..> UCAuth : <<include>>
UC07 ..> UCAuth : <<include>>
UC09 ..> UCAuth : <<include>>
UC10 ..> UCAuth : <<include>>

UC07 ..> UC08 : <<include>>
UC08 ..> UCEstoque : <<include>>
UC09 ..> UCConfPag : <<include>>

UC03 ..> UCCancel : <<extend>>
@enduml
