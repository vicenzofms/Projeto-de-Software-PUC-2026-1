@startuml
skinparam componentStyle rectangle

actor Cliente
actor Funcionario
actor Gerente

package "Frontend" {
  [Web App] as Web
}

package "Backend (Next.js)" {
  [API REST] as API

  interface "IAutenticacao" as IAuth
  interface "IUsuarios" as IUsr
  interface "IClientes" as ICli
  interface "ICatalogo" as ICat
  interface "IOrdemServico" as IOS
  interface "IOrcamento" as IOrc
  interface "IPagamento" as IPag
  interface "IRelatorios" as IRel
  interface "INotificacao" as INot
  interface "IPersistencia" as IPers

  [AuthModule]
  [UsuariosModule]
  [ClientesModule]
  [CatalogoModule]
  [OrdemServicoModule]
  [OrcamentoModule]
  [PagamentoModule]
  [RelatoriosModule]
  [NotificacaoModule]

  API -- IAuth
  API -- IUsr
  API -- ICli
  API -- ICat
  API -- IOS
  API -- IOrc
  API -- IPag
  API -- IRel

  IAuth --> [AuthModule]
  IUsr --> [UsuariosModule]
  ICli --> [ClientesModule]
  ICat --> [CatalogoModule]
  IOS --> [OrdemServicoModule]
  IOrc --> [OrcamentoModule]
  IPag --> [PagamentoModule]
  IRel --> [RelatoriosModule]

  [NotificacaoModule] -- INot
  [OrdemServicoModule] ..> INot
  [PagamentoModule] ..> INot
}

package "Infraestrutura" {
  [Prisma ORM]
  [JWT Provider]
  database "PostgreSQL"
}

cloud "Sistema de Pagamento" as SP
cloud "Servico SMTP" as SMTP

Cliente --> Web
Funcionario --> Web
Gerente --> Web
Web --> API : HTTP/REST

[Prisma ORM] -- IPers
[UsuariosModule] ..> IPers : TCP/IP
[ClientesModule] ..> IPers : TCP/IP
[CatalogoModule] ..> IPers : TCP/IP
[OrdemServicoModule] ..> IPers : TCP/IP
[OrcamentoModule] ..> IPers : TCP/IP
[PagamentoModule] ..> IPers : TCP/IP
[RelatoriosModule] ..> IPers : TCP/IP

[AuthModule] --> [JWT Provider] : valida JWT
[Prisma ORM] --> PostgreSQL : TCP/IP (5432)
[PagamentoModule] --> SP : HTTPS REST
[NotificacaoModule] --> SMTP : SMTP
@enduml
