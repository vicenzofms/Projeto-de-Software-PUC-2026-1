@startuml

left to right direction
skinparam packageStyle rectangle

actor Atleta
actor Organizador
actor "Sistema\n(Automático)" as Sistema

rectangle "Sistema de Gestão das Olimpíadas (SGO)" {

    ' ---- Casos de uso do Atleta ----
    usecase "Inscrever em Competição"     as UC01
    usecase "Consultar Competições"       as UC02
    usecase "Consultar Resultados"        as UC03
    usecase "Cancelar Inscrição"          as UC04

    ' ---- Casos de uso do Organizador ----
    usecase "Cadastrar Competição"        as UC05
    usecase "Alocar Local"                as UC06
    usecase "Verificar Conflito de\nHorário" as UC07
    usecase "Registrar Resultado"         as UC08
    usecase "Definir Classificação\n(1º, 2º e 3º)" as UC09
    usecase "Gerar Relatório\nde Medalhas" as UC10
    usecase "Gerenciar Atletas"           as UC11

    ' ---- Casos de uso automáticos ----
    usecase "Contabilizar Medalhas\npor País" as UC12
    usecase "Notificar Atleta"            as UC13

    ' ---- Relações do Atleta ----
    Atleta --> UC01
    Atleta --> UC02
    Atleta --> UC03
    Atleta --> UC04

    ' ---- Relações do Organizador ----
    Organizador --> UC05
    Organizador --> UC06
    Organizador --> UC08
    Organizador --> UC10
    Organizador --> UC11

    ' ---- Relações do Sistema ----
    Sistema --> UC12
    Sistema --> UC13

    ' ---- Includes ----
    UC01 ..> UC02 : <<include>>
    UC06 ..> UC07 : <<include>>
    UC08 ..> UC09 : <<include>>
    UC12 ..> UC10 : <<include>>

    ' ---- Extends ----
    UC04 ..> UC01 : <<extend>>
    UC13 ..> UC01 : <<extend>>
    UC13 ..> UC08 : <<extend>>
}

@enduml
